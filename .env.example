# Copy to .env.local. Never commit real values.

# Public base URL, used for canonical and Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. npm run db:dev starts a local server using these credentials.
DATABASE_URL=postgresql://movexa:change-me@localhost:5433/movexa

# Sessions. Generate a long random value, at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First Owner account, created by npm run db:seed. At least 12 characters.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Media library uploads. Without these the admin shows a setup note instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
