# Copy to .env.local. Never commit real values.

# Production: set the real domain, such as https://www.example.com
# Public base URL, used for canonical and Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. npm run db:dev starts a local server using these credentials.
DATABASE_URL=postgresql://movexa:change-me@localhost:5433/movexa
# Production only, if the host pools connections: the direct string, used for migrations
# DIRECT_URL=

# Sessions. Generate a long random value, at least 32 characters.
BETTER_AUTH_SECRET=
# Production: the same real domain, on https
BETTER_AUTH_URL=http://localhost:3000

# First Owner account, created by npm run db:seed. At least 12 characters.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Media library uploads. Without these the admin shows a setup note instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
