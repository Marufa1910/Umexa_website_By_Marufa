generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  EDITOR
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum Currency {
  USD
  BDT
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  PROPOSAL_SENT
  WON
  LOST
  ARCHIVED
}

// ---------- Authentication (tables used by Better Auth) ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(EDITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  auditLogs     AuditLog[]
  inquiryNotes  InquiryNote[]
  statusChanges InquiryStatusChange[]
  mediaAssets   MediaAsset[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Shared by Better Auth (login attempts) and the contact form. Keys hold no raw IP addresses.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ---------- Portfolio ----------

model Project {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  shortDescription String
  fullDescription  String
  objectives       String[]
  creativeStrategy String
  /// [{ title, copy }]
  process          Json              @default("[]")
  deliverables     String[]
  year             Int
  coverUrl         String
  coverAlt         String
  videoUrl         String?
  featured         Boolean           @default(false)
  status           PublicationStatus @default(DRAFT)
  sortOrder        Int               @default(0)
  /// Fictional sample content: shown with a visible label on the public site
  isSample         Boolean           @default(false)
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  categories       ProjectCategory[]
  media            ProjectMedia[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([status, deletedAt, sortOrder])
  @@index([featured])
  @@index([clientId])
}

model Category {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  sortOrder Int               @default(0)
  projects  ProjectCategory[]
  services  ServiceCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sortOrder])
}

model ProjectCategory {
  projectId  String
  categoryId String
  /// The lowest value is the category shown on the project card
  sortOrder  Int      @default(0)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@index([categoryId])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      MediaKind @default(IMAGE)
  url       String
  posterUrl String?
  alt       String
  width     Int
  height    Int
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, sortOrder])
}

// ---------- Services ----------

model Service {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  summary        String
  intro          String
  previewUrl     String
  capabilities   String[]
  deliverables   String[]
  /// [{ title, copy }]
  workflow       Json              @default("[]")
  /// [{ question, answer }]
  faq            Json              @default("[]")
  status         PublicationStatus @default(DRAFT)
  sortOrder      Int               @default(0)
  seoTitle       String?
  seoDescription String?
  categories     ServiceCategory[]
  inquiries      Inquiry[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([status, deletedAt, sortOrder])
}

/// Which portfolio categories count as relevant work for a service
model ServiceCategory {
  serviceId  String
  categoryId String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([serviceId, categoryId])
  @@index([categoryId])
}

// ---------- People and proof ----------

model Client {
  id         String    @id @default(cuid())
  name       String
  logoUrl    String?
  websiteUrl String?
  industry   String?
  featured   Boolean   @default(false)
  isSample   Boolean   @default(false)
  sortOrder  Int       @default(0)
  projects   Project[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([featured, deletedAt, sortOrder])
}

model Testimonial {
  id          String            @id @default(cuid())
  clientName  String
  designation String
  company     String
  quote       String
  photoUrl    String?
  status      PublicationStatus @default(DRAFT)
  /// Sample quotes are labelled publicly. Only real, verified feedback should have this off.
  isSample    Boolean           @default(false)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@index([status, deletedAt, sortOrder])
}

model TeamMember {
  id        String            @id @default(cuid())
  name      String
  jobTitle  String
  bio       String?
  photoUrl  String?
  status    PublicationStatus @default(DRAFT)
  isSample  Boolean           @default(false)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  @@index([status, deletedAt, sortOrder])
}

// ---------- Inquiries ----------

model Inquiry {
  id            String                @id @default(cuid())
  fullName      String
  email         String
  company       String?
  country       String
  /// Null when the visitor chose "Not sure yet", or the service was later removed
  serviceId     String?
  service       Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  currency      Currency
  budget        String
  timeline      String
  description   String
  referenceUrl  String?
  status        InquiryStatus         @default(NEW)
  notes         InquiryNote[]
  statusChanges InquiryStatusChange[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([serviceId])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model InquiryStatusChange {
  id          String        @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStatus  InquiryStatus
  toStatus    InquiryStatus
  changedById String?
  changedBy   User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([inquiryId, createdAt])
}

// ---------- Settings and audit ----------

/// A single row (id = "default"): one set of site-wide settings
model SiteSetting {
  id             String   @id @default("default")
  agencyName     String   @default("UMEXA")
  logoUrl        String?
  contactEmail   String?
  phone          String?
  whatsapp       String?
  location       String?
  /// [{ label, href }]
  socials        Json     @default("[]")
  seoTitle       String?
  seoDescription String?
  showreelUrl    String?
  showreelPoster String?
  /// True while the showreel is placeholder footage
  showreelSample Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

// ---------- Media library ----------

/// A file stored on Cloudinary. Details come from Cloudinary's API, never from the browser.
model MediaAsset {
  id           String    @id @default(cuid())
  publicId     String    @unique
  url          String
  kind         MediaKind
  format       String
  bytes        Int
  width        Int?
  height       Int?
  alt          String    @default("")
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([kind, createdAt])
}
